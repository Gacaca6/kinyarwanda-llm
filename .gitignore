# CLAUDE.md §6: never commit large data or model weights.

# Raw downloaded corpora (one dir per source). Keep readers + SOURCES.md, not data.
# NB: ignore the directory *contents* (data/sources/*), not the directory itself —
# git cannot re-include a file whose parent directory is excluded.
data/sources/*
!data/sources/SOURCES.md

# Phase 2 cleaned/split corpus (large — train/val/test live here).
data/processed/

# Model checkpoints / weights
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Training artifacts
*.log
loss_curve*.png
runs/
wandb/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
